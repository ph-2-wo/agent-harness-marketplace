{
  "SessionStart": [
    {
      "matcher": "startup|resume|clear",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/.apm/skills/create-next-action/scripts/na.mjs\" session-start",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/.apm/skills/create-next-action/scripts/na.mjs\" turn",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/.apm/skills/create-next-action/scripts/na.mjs\" stop",
          "timeout": 10
        }
      ]
    }
  ]
}
